{
  "name": "medical-center-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for Medical Center API",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:sqlserver": "cross-env DB_PROVIDER=SqlServer jest --runInBand",
    "test:postgres": "cross-env DB_PROVIDER=Postgres jest --runInBand",
    "test:sqlite": "cross-env DB_PROVIDER=Sqlite jest --runInBand",
    "test:mysql": "cross-env DB_PROVIDER=MySql jest --runInBand",
    "test:all-dbs": "npm run test:sqlserver && npm run test:postgres && npm run test:sqlite && npm run test:mysql"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  }
}
