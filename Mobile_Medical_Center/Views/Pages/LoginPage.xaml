<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_Medical_Center.Views.Pages.LoginPage"
             Title="Вхід"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <Grid RowDefinitions="*,Auto" Padding="20">
        <ScrollView>
            <StackLayout Spacing="20" VerticalOptions="Center">
                <!-- Logo/Title -->
                <Label Text="Медичний Центр"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"/>

                <Label Text="Мобільний додаток"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                <!-- Spacer -->
                <BoxView HeightRequest="20" Color="Transparent"/>

                <!-- Email Input -->
                <Label Text="Email:" FontAttributes="Bold"/>
                <Entry x:Name="EmailEntry"
                       Placeholder="Введіть email"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       ClearButtonVisibility="WhileEditing"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#2C2C2C}"/>

                <!-- Password Input -->
                <Label Text="Пароль:" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Entry x:Name="PasswordEntry"
                       Placeholder="Введіть пароль"
                       Text="{Binding Password}"
                       IsPassword="{Binding ShowPassword, Converter={StaticResource InvertedBoolConverter}}"
                       ClearButtonVisibility="WhileEditing"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#2C2C2C}"/>

                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       FontSize="14"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Spacer -->
                <BoxView HeightRequest="10" Color="Transparent"/>

                <!-- Login Button -->
                <Button Text="Увійти"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        CornerRadius="10"
                        Padding="0,15"/>

                <!-- Register Link -->
                <Label HorizontalTextAlignment="Center"
                       FontSize="14"
                       Margin="0,20,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Немаєте аккаунту? "/>
                            <Span Text="Реєструюсь"
                                  TextColor="{StaticResource Primary}"
                                  TextDecorations="Underline"/>
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RegisterCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Primary}"/>
    </Grid>
</ContentPage>
