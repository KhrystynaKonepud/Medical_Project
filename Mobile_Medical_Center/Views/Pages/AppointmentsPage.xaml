<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile_Medical_Center.Views.Pages.AppointmentsPage"
             Title="Записи на прийом">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0" RowSpacing="0" ColumnSpacing="0">
        <!-- Book Appointment Section -->
        <StackLayout Padding="15" Spacing="10" BackgroundColor="#f5f5f5">
            <Label Text="Забронювати прийом" FontAttributes="Bold" FontSize="16"/>

            <Picker Title="Виберіть лікаря"
                    ItemsSource="{Binding Doctors}"
                    ItemDisplayBinding="{Binding FullName}"
                    SelectedItem="{Binding SelectedDoctor}"/>

            <Picker Title="Виберіть пацієнта"
                    ItemsSource="{Binding Patients}"
                    ItemDisplayBinding="{Binding FullName}"
                    SelectedItem="{Binding SelectedPatient}"/>

            <DatePicker Date="{Binding AppointmentDate}"/>

            <Entry Placeholder="Причина візиту" Text="{Binding Reason}"/>

            <Button Text="Забронювати"
                    Command="{Binding BookAppointmentCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    CornerRadius="8"/>
        </StackLayout>

        <!-- Appointments List -->
        <RefreshView Grid.Row="1"
                     Command="{Binding LoadAppointmentsCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <CollectionView ItemsSource="{Binding Appointments}"
                           SelectionMode="Single"
                           SelectionChangedCommand="{Binding SelectionChangedCommand}"
                           SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="15" Spacing="8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#2C2C2C}"
                                    Margin="0,0,0,1">
                            <Label Text="{Binding Doctor.FullName}" FontAttributes="Bold" FontSize="16"/>
                            <Label Text="{Binding Patient.FullName}" FontSize="14" TextColor="{StaticResource Gray500}"/>
                            <Label Text="{Binding AppointmentDate, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}" FontSize="12"/>
                            <Label Text="{Binding Reason, StringFormat='Причина: {0}'}" FontSize="12"/>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold"/>
                                <Button Text="Змінити статус"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChangeStatusCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="10"
                                        Padding="5,3"/>
                            </StackLayout>

                            <Button Text="Видалити"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteAppointmentCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource Danger}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="10,5"/>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Немає записів на прийом" HorizontalTextAlignment="Center"/>
                        <Label Text="Натисніть кнопку вище, щоб забронювати прийом" HorizontalTextAlignment="Center" FontSize="12"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Primary}"/>
    </Grid>
</ContentPage>
