{
  "DatabaseProvider": "SqlServer", // Можна змінити на "Postgres", "Sqlite" або "InMemory"

  "ConnectionStrings": {
    "SqlServerConnection": "Server=(localdb)\\mssqllocaldb;Database=MedicalCenterDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "PostgresConnection": "Host=localhost;Database=MedicalCenterDb;Username=postgres;Password=yourpassword",
    "SqliteConnection": "Data Source=medicalcenter.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
